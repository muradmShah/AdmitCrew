# Copy to .env and fill locally. Never paste a secret into chat or browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_BACKEND_SECRET_KEY
# Optional; leave blank for explicitly labelled rule-based mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required with Supabase. Local demo default: admitcrew-demo
STAFF_PASSWORD=
STAFF_EMAIL=admin@admitcrew.local
AUTO_REMINDERS=false
